# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Locally built protoc plugins (see bin/generate_holder_proto.sh)
go/.tools/

# Local SSL certs generated by bin/setup_local_ssl.sh (mkcert) or the proxy
# container's self-signed placeholder fallback — both are machine-specific.
docker/proxy/certs/*
!docker/proxy/certs/.gitkeep

# `go build ./cmd/<name>` run from go/ drops the binary in go/ itself.
# Anchored so the go/cmd/<name>/ source directories stay tracked.
/go/events
/go/migrate
/go/orchestrator
/go/server
/go/simulate

# TLC's working files (make tla-check, spec/trace/validate.sh) and the traces
# make tla-trace records.
states/
*_TTrace_*.tla
*_TTrace_*.bin
/go/.tla-traces/
