# pkg:gem/holidays#lib/holidays/definition/repository/custom_methods.rb:4
class Holidays::Definition::Repository::CustomMethods
  # pkg:gem/holidays#lib/holidays/definition/repository/custom_methods.rb:5
  def initialize; end

  # When a conflict is detected the method is stored as a regional override keyed by its regions.
  # find() then resolves the right implementation at lookup time using the queried region.
  #
  # pkg:gem/holidays#lib/holidays/definition/repository/custom_methods.rb:13
  def add(new_custom_methods, new_sources = T.unsafe(nil), function_regions = T.unsafe(nil)); end

  # Returns the proc for the given method_id.
  #
  # When a region is supplied, regional overrides are checked first so
  # that conflicting methods with the same name but different logic each
  # resolve to their own implementation.
  #
  # pkg:gem/holidays#lib/holidays/definition/repository/custom_methods.rb:42
  def find(method_id, region = T.unsafe(nil)); end
end

