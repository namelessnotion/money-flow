# pkg:gem/holidays#lib/holidays/definition/generator/module.rb:5
module Holidays::Definition::Generator; end

# pkg:gem/holidays#lib/holidays/definition/generator/module.rb:6
class Holidays::Definition::Generator::Module
  # NOTE: +custom_methods+ is accepted for backwards-compatible call sites but is
  # no longer baked into the generated module. Per-region custom methods are now
  # hosted natively under lib/holidays/definition/custom_methods/ and seeded into
  # the repository at boot. YAML files that still carry methods:/ruby: blocks are
  # tolerated: their bodies are simply ignored here.
  #
  # pkg:gem/holidays#lib/holidays/definition/generator/module.rb:12
  def call(module_name, files, regions, month_strings, custom_methods = T.unsafe(nil)); end
end

# pkg:gem/holidays#lib/holidays/definition/generator/regions.rb:4
class Holidays::Definition::Generator::Regions
  # pkg:gem/holidays#lib/holidays/definition/generator/regions.rb:9
  def call(regions, region_names = T.unsafe(nil)); end

  private

  # pkg:gem/holidays#lib/holidays/definition/generator/regions.rb:42
  def generate_parent_lookup(regions); end

  # Symbol keys and string values are emitted via inspect so the literal
  # round-trips exactly: YAML-reserved keys like :no stay symbols and
  # values with quotes or commas are escaped rather than breaking the hash.
  #
  # pkg:gem/holidays#lib/holidays/definition/generator/regions.rb:59
  def generate_region_names(region_names); end

  # pkg:gem/holidays#lib/holidays/definition/generator/regions.rb:32
  def to_array(regions); end

  # pkg:gem/holidays#lib/holidays/definition/generator/regions.rb:26
  def validate!(regions); end
end

