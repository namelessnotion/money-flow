class Holidays::Finder::Context::ParseOptions
  # pkg:gem/holidays#lib/holidays/finder/context/parse_options.rb:5
  def initialize(regions_repo, region_validator, definition_loader); end

  # Returns [(arr)regions, (bool)observed, (bool)informal]
  #
  # pkg:gem/holidays#lib/holidays/finder/context/parse_options.rb:12
  def call(*options); end

  private

  # pkg:gem/holidays#lib/holidays/finder/context/parse_options.rb:87
  def is_wildcard?(r); end

  # pkg:gem/holidays#lib/holidays/finder/context/parse_options.rb:96
  def load_region!(r); end

  # pkg:gem/holidays#lib/holidays/finder/context/parse_options.rb:91
  def load_wildcard_parent!(wildcard_region); end

  # Check regions against list of supported regions and return an array of
  # symbols.
  #
  # If a wildcard region is found (e.g. :ca_) it is expanded into all
  # of its available sub regions.
  #
  # pkg:gem/holidays#lib/holidays/finder/context/parse_options.rb:32
  def parse_regions!(regions); end

  # pkg:gem/holidays#lib/holidays/finder/context/parse_options.rb:81
  def validate!(regions); end
end

# pkg:gem/holidays#lib/holidays/finder/context/search.rb:4
class Holidays::Finder::Context::Search
  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:5
  def initialize(holidays_by_month_repo, custom_method_processor, day_of_month_calculator, rules); end

  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:12
  def call(dates_driver, regions, options); end

  private

  # When the queried region is :any (or no holiday_regions are provided), fall back
  # to the holiday's own first region. Otherwise use the first queried region that
  # also appears in the holiday's region list so that region-specific function
  # implementations resolve correctly even when a holiday definition is shared across
  # multiple regions.
  #
  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:108
  def build_custom_method_input(year, month, day, queried_regions, holiday_regions = T.unsafe(nil)); end

  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:76
  def build_date(year, month, h, queried_regions); end

  # Observed methods default to taking only a date, but they may declare
  # additional arguments such as :region so that a single definition shared
  # across regions can observe differently in one of them.
  #
  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:126
  def build_observed_date(date, regions, h); end

  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:85
  def custom_holidays(year, month, h, queried_regions); end

  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:68
  def informal_set?(options); end

  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:64
  def informal_type?(type); end

  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:72
  def observed_set?(options); end

  # pkg:gem/holidays#lib/holidays/finder/context/search.rb:52
  def validate!(dates_driver); end
end

