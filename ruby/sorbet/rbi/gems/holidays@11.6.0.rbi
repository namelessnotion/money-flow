# pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:3
class Holidays::DateCalculator::WeekendModifier
  # Move date to Monday if it occurs on a Sunday.
  # Does not modify the date if it is not a Sunday.
  # Used as a callback function.
  #
  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:15
  def to_monday_if_sunday(date); end

  # Move date to Monday if it occurs on a Saturday on Sunday.
  # Does not modify date if it is not a weekend.
  # Used as a callback function.
  #
  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:7
  def to_monday_if_weekend(date); end

  # Finds the next weekday. For example, if a 'Friday' date is received
  # it will return the following Monday. If Sunday then return Monday,
  # if Saturday return Monday, if Tuesday return Wednesday, etc.
  #
  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:74
  def to_next_weekday(date); end

  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:95
  def to_previous_day_if_leap_year(date); end

  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:24
  def to_the_second_weekday_after(date); end

  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:20
  def to_the_weekday_after(date); end

  # if Christmas falls on a Saturday, move it to the next Monday (Boxing Day will be Sunday and potentially Tuesday)
  # if Christmas falls on a Sunday, move it to the next Tuesday (Boxing Day will go on Monday)
  #
  # if Boxing Day falls on a Saturday, move it to the next Monday (Christmas will go on Friday)
  # if Boxing Day falls on a Sunday, move it to the next Tuesday (Christmas will go on Saturday & Monday)
  #
  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:45
  def to_tuesday_if_sunday_or_monday_if_saturday(date); end

  # Move Boxing Day if it falls on a weekend, leaving room for Christmas.
  # Used as a callback function.
  #
  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:30
  def to_weekday_if_boxing_weekend(date); end

  # Call to_weekday_if_boxing_weekend but first get date based on year
  # Used as a callback function.
  #
  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:58
  def to_weekday_if_boxing_weekend_from_year(year); end

  # Call to_weekday_if_boxing_weekend but first get date based on year
  # Used as a callback function.
  #
  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:52
  def to_weekday_if_boxing_weekend_from_year_or_to_tuesday_if_monday(year); end

  # Move date to Monday if it occurs on a Sunday or to Friday if it occurs on a
  # Saturday.
  # Used as a callback function.
  #
  # pkg:gem/holidays#lib/holidays/date_calculator/weekend_modifier.rb:65
  def to_weekday_if_weekend(date); end
end

