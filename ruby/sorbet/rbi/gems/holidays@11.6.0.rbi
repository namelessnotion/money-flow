# pkg:gem/holidays#lib/holidays/finder/context/dates_driver_builder.rb:10
class Holidays::Finder::Context::DatesDriverBuilder
  # pkg:gem/holidays#lib/holidays/finder/context/dates_driver_builder.rb:11
  def call(start_date, end_date); end

  private

  # As part of https://github.com/holidays/holidays/issues/146 I am returning
  # additional months in an attempt to catch month-spanning date situations (i.e.
  # dates falling on 2/1 but being observed on 1/31). By including the additional months
  # we are increasing runtimes slightly but improving accuracy, which is more important
  # to me at this stage.
  #
  # pkg:gem/holidays#lib/holidays/finder/context/dates_driver_builder.rb:29
  def add_border_months(current_date, dates_driver); end

  # pkg:gem/holidays#lib/holidays/finder/context/dates_driver_builder.rb:49
  def clean(dates_driver); end
end

