# tr custom holiday calculations.
#
# Ramazan Bayramı is 1 Shawwal and Kurban Bayramı is 10 Dhul-Hijjah of
# the Hijri calendar. Both are derived from the arithmetic Islamic
# calendar (Holidays::DateCalculator::HijriDate). The civil holidays are
# proclaimed by Türkiye's Diyanet and in most years so far have landed a
# day (2016 Ramazan Bayramı, two days) before the arithmetic result;
# DIYANET_OVERRIDES pins those years to the proclaimed date. Years with
# no entry fall back to the calculation. See definitions#377.
#
# pkg:gem/holidays#lib/holidays/definition/custom_methods/tr.rb:15
module Holidays::Definition::CustomMethods::TR
  class << self
    # pkg:gem/holidays#lib/holidays/definition/custom_methods/tr.rb:50
    def ramadan_feast(year); end

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/tr.rb:54
    def sacrifice_feast(year); end

    private

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/tr.rb:60
    def feast(name, year, hijri_month, hijri_day); end
  end
end

# pkg:gem/holidays#lib/holidays/definition/custom_methods/tr.rb:17
Holidays::Definition::CustomMethods::TR::DHU_AL_HIJJAH = T.let(T.unsafe(nil), Integer)

# Proclaimed first days that differ from the arithmetic calendar,
# keyed by [feast, gregorian_year]. Sourced from the Diyanet dates
# that the definition file previously carried as a fixed table, plus
# https://vakithesaplama.diyanet.gov.tr/resmitatiller.php for 2021-2030.
#
# pkg:gem/holidays#lib/holidays/definition/custom_methods/tr.rb:23
Holidays::Definition::CustomMethods::TR::DIYANET_OVERRIDES = T.let(T.unsafe(nil), Hash)

# pkg:gem/holidays#lib/holidays/definition/custom_methods/tr.rb:16
Holidays::Definition::CustomMethods::TR::SHAWWAL = T.let(T.unsafe(nil), Integer)

# us custom holiday calculations, ported verbatim from the
# +methods:+ block in definitions/us.yaml.
#
# pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:8
module Holidays::Definition::CustomMethods::US
  class << self
    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:10
    def christmas_eve_holiday(date); end

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:102
    def election_day(year); end

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:106
    def even_year_election_day(year); end

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:41
    def georgia_state_holiday(year, month); end

    # Independence Day observed shift, which varies by region:
    #   - us_ri: Rhode Island moves to the following Monday on a weekend
    #     (Saturday -> +2, Sunday -> +1).
    #   - us_tx: Texas does not shift, the date is returned unchanged.
    #   - everyone else: nearest weekday, same as +to_weekday_if_weekend+
    #     (Saturday -> Friday, Sunday -> Monday).
    #
    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:81
    def independence_day(region, date); end

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:54
    def juneteenth_national_independence_day(region, date); end

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:47
    def lee_jackson_day(year, month); end

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:15
    def rosh_hashanah(year); end

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:112
    def us_inauguration_day(year); end

    # pkg:gem/holidays#lib/holidays/definition/custom_methods/us.rb:28
    def yom_kippur(year); end
  end
end

