  # Enables GC Optimizations if you're running REE.
  # http://www.rubyenterpriseedition.com/faq.html#adapt_apps_for_cow
  #
  # pkg:gem/resque#lib/resque/worker.rb:411
  def enable_gc_optimizations; end

  # Given a Ruby object, returns a string suitable for storage in a
  # queue.
  #
  # pkg:gem/resque#lib/resque/worker.rb:39
  def encode(object); end

  # How many failed jobs has this worker seen? Returns an int.
  #
  # pkg:gem/resque#lib/resque/worker.rb:791
  def failed; end

  # Tells Redis we've failed a job.
  #
  # pkg:gem/resque#lib/resque/worker.rb:796
  def failed!; end

  # pkg:gem/resque#lib/resque/worker.rb:65
  def fork_per_job=(_arg0); end

  # pkg:gem/resque#lib/resque/worker.rb:829
  def fork_per_job?; end

