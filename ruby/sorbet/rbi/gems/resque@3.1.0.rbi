# The Failure module provides an interface for working with different
# failure backends.
#
# You can use it to query the failure backend without knowing which specific
# backend is being used. For instance, the Resque web app uses it to display
# stats and other information.
#
# pkg:gem/resque#lib/resque/failure.rb:8
module Resque::Failure
  class << self
    # Returns an array of all the failures, paginated.
    #
    # `offset` is the int of the first item in the page, `limit` is the
    # number of items to return.
    #
    # pkg:gem/resque#lib/resque/failure.rb:96
    def all(offset = T.unsafe(nil), limit = T.unsafe(nil), queue = T.unsafe(nil)); end

    # Returns the current backend class. If none has been set, falls
    # back to `Resque::Failure::Redis`
    #
    # pkg:gem/resque#lib/resque/failure.rb:55
    def backend; end

    # Sets the current backend. Expects a class descendent of
    # `Resque::Failure::Base`.
    #
    # Example use:
    #   require 'resque/failure/airbrake'
    #   Resque::Failure.backend = Resque::Failure::Airbrake
    #
    # pkg:gem/resque#lib/resque/failure.rb:48
    def backend=(backend); end

    # Clear all failure jobs
    #
    # pkg:gem/resque#lib/resque/failure.rb:111
    def clear(queue = T.unsafe(nil)); end

    # pkg:gem/resque#lib/resque/failure.rb:115
    def clear_retried; end

    # Returns the int count of how many failures we have seen.
    #
    # pkg:gem/resque#lib/resque/failure.rb:88
    def count(queue = T.unsafe(nil), class_name = T.unsafe(nil)); end

    # Creates a new failure, which is delegated to the appropriate backend.
    #
    # Expects a hash with the following keys:
    #   :exception  - The Exception object
    #   :worker     - The Worker object who is reporting the failure
    #   :queue      - The string name of the queue from which the job was pulled
    #   :payload    - The job's payload
    #   :failure_id - Optional id to record this failure under, in place of the
    #                 one the backend generates for itself.
    #
    # pkg:gem/resque#lib/resque/failure.rb:18
    def create(options = T.unsafe(nil)); end

    # Iterate across all failures with the given options
    #
    # pkg:gem/resque#lib/resque/failure.rb:101
    def each(offset = T.unsafe(nil), limit = T.unsafe(nil), queue = T.unsafe(nil), class_name = T.unsafe(nil), order = T.unsafe(nil), &block); end

    # Obtain the failure queue name for a given job queue
    #
    # pkg:gem/resque#lib/resque/failure.rb:71
    def failure_queue_name(job_queue_name); end

    # pkg:gem/resque#lib/resque/failure.rb:30
    def generate_failure_ids=(_arg0); end

    # Whether failures are given a `failure_id` when they are built.
    # Defaults to true. An explicit `:failure_id` passed to `create` sets the
    # `failure_id` even if automatic generation is disabled.
    #
    # pkg:gem/resque#lib/resque/failure.rb:35
    def generate_failure_ids?; end

    # Obtain the job queue name for a given failure queue
    #
    # pkg:gem/resque#lib/resque/failure.rb:78
    def job_queue_name(failure_queue_name); end

    # Returns an array of all the failed queues in the system
    #
    # pkg:gem/resque#lib/resque/failure.rb:83
    def queues; end

    # pkg:gem/resque#lib/resque/failure.rb:125
    def remove(id, queue = T.unsafe(nil)); end

    # Removes all failed jobs in a specific queue.
    # Queue name should be a string.
    #
    # pkg:gem/resque#lib/resque/failure.rb:142
    def remove_queue(queue); end

    # pkg:gem/resque#lib/resque/failure.rb:121
    def requeue(id, queue = T.unsafe(nil)); end

    # Requeues all failed jobs
    #
    # pkg:gem/resque#lib/resque/failure.rb:136
    def requeue_all; end

    # Requeues all failed jobs in a specific queue.
    # Queue name should be a string.
    #
    # pkg:gem/resque#lib/resque/failure.rb:131
    def requeue_queue(queue); end

    # The string url of the backend's web interface, if any.
    #
    # pkg:gem/resque#lib/resque/failure.rb:106
    def url; end
  end
end

# All Failure classes are expected to subclass Base.
#
# When a job fails, a new instance of your Failure backend is created
# and #save is called.
#
# pkg:gem/resque#lib/resque/failure/base.rb:7
class Resque::Failure::Base
  # pkg:gem/resque#lib/resque/failure/base.rb:24
  def initialize(exception, worker, queue, payload); end

  # The exception object raised by the failed job
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:9
  def exception; end

  # The exception object raised by the failed job
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:9
  def exception=(_arg0); end

  # A unique identifier for this failure, shared by every backend that
  # accepts one. Nil when generation is turned off.
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:22
  def failure_id; end

  # A unique identifier for this failure, shared by every backend that
  # accepts one. Nil when generation is turned off.
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:22
  def failure_id=(_arg0); end

  # Logging!
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:73
  def log(message); end

  # The payload object associated with the failed job
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:18
  def payload; end

  # The payload object associated with the failed job
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:18
  def payload=(_arg0); end

  # The string name of the queue from which the failed job was pulled
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:15
  def queue; end

  # The string name of the queue from which the failed job was pulled
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:15
  def queue=(_arg0); end

  # When a job fails, a new instance of your Failure backend is created
  # and #save is called.
  #
  # This is where you POST or PUT or whatever to your Failure service.
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:36
  def save; end

  # The worker object who detected the failure
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:12
  def worker; end

  # The worker object who detected the failure
  #
  # pkg:gem/resque#lib/resque/failure/base.rb:12
  def worker=(_arg0); end

  class << self
    # Returns a paginated array of failure objects.
    #
    # pkg:gem/resque#lib/resque/failure/base.rb:50
    def all(offset = T.unsafe(nil), limit = T.unsafe(nil), queue = T.unsafe(nil)); end

    # Clear all failure objects
    #
    # pkg:gem/resque#lib/resque/failure/base.rb:63
    def clear(*args); end

    # The number of failures.
    #
    # pkg:gem/resque#lib/resque/failure/base.rb:40
    def count(queue = T.unsafe(nil), class_name = T.unsafe(nil)); end

    # Iterate across failed objects
    #
    # pkg:gem/resque#lib/resque/failure/base.rb:55
    def each(*args); end

    # Returns an array of all available failure queues
    #
    # pkg:gem/resque#lib/resque/failure/base.rb:45
    def queues; end

    # pkg:gem/resque#lib/resque/failure/base.rb:69
    def remove(*args); end

    # pkg:gem/resque#lib/resque/failure/base.rb:66
    def requeue(*args); end

    # A URL where someone can go to view failures.
    #
    # pkg:gem/resque#lib/resque/failure/base.rb:59
    def url; end
  end
end

# Methods used by various classes in Resque.
#
# pkg:gem/resque#lib/resque/helpers.rb:18
module Resque::Helpers
  # Given a word with dashes, returns a camel cased version of it.
  #
  # pkg:gem/resque#lib/resque/helpers.rb:44
  def classify(dashed_word); end

  # Tries to find a constant with the name specified in the argument string
  #
  # pkg:gem/resque#lib/resque/helpers.rb:49
  def constantize(camel_cased_word); end

  # Given a string, returns a Ruby object.
  #
  # pkg:gem/resque#lib/resque/helpers.rb:39
  def decode(object); end

  # Given a Ruby object, returns a string suitable for storage in a
  # queue.
  #
  # pkg:gem/resque#lib/resque/helpers.rb:34
  def encode(object); end

  # Direct access to the Redis instance.
  #
  # pkg:gem/resque#lib/resque/helpers.rb:22
  def redis; end
end

# pkg:gem/resque#lib/resque/helpers.rb:19
class Resque::Helpers::DecodeException < ::StandardError; end

# A Resque::Job represents a unit of work. Each job lives on a
# single queue and has an associated payload object. The payload
# is a hash with two attributes: `class` and `args`. The `class` is
# the name of the Ruby class which should be used to run the
# job. The `args` are an array of arguments which should be passed
# to the Ruby class's `perform` class-level method.
#
# You can manually run a job using this code:
#
#   job = Resque::Job.reserve(:high)
#   klass = Resque::Job.constantize(job.payload['class'])
#   klass.perform(*job.payload['args'])
#
# pkg:gem/resque#lib/resque/job.rb:14
class Resque::Job
  include ::Resque::Helpers
  extend ::Resque::Helpers

  # pkg:gem/resque#lib/resque/job.rb:76
  def initialize(queue, payload); end

  # Equality
  #
  # pkg:gem/resque#lib/resque/job.rb:261
  def ==(other); end

  # pkg:gem/resque#lib/resque/job.rb:275
  def after_hooks; end

  # pkg:gem/resque#lib/resque/job.rb:283
  def always_hooks; end

  # Returns an array of args represented in this job's payload.
  #
  # pkg:gem/resque#lib/resque/job.rb:228
  def args; end

  # pkg:gem/resque#lib/resque/job.rb:271
  def around_hooks; end

  # pkg:gem/resque#lib/resque/job.rb:267
  def before_hooks; end

  # Given a word with dashes, returns a camel cased version of it.
  #
  # pkg:gem/resque#lib/resque/job.rb:53
  def classify(dashed_word); end

  # Tries to find a constant with the name specified in the argument string
  #
  # pkg:gem/resque#lib/resque/job.rb:58
  def constantize(camel_cased_word); end

  # pkg:gem/resque#lib/resque/job.rb:20
  def data_store; end

  # Given a string, returns a Ruby object.
  #
  # pkg:gem/resque#lib/resque/job.rb:37
  def decode(object); end

  # Given a Ruby object, returns a string suitable for storage in a
  # queue.
  #
  # pkg:gem/resque#lib/resque/job.rb:32
  def encode(object); end

  # Given an exception object, hands off the needed parameters to
  # the Failure module.
  #
  # pkg:gem/resque#lib/resque/job.rb:234
  def fail(exception); end

  # pkg:gem/resque#lib/resque/job.rb:279
  def failure_hooks; end

  # pkg:gem/resque#lib/resque/job.rb:221
  def has_payload_class?; end

  # String representation
  #
  # pkg:gem/resque#lib/resque/job.rb:255
  def inspect; end

  # This job's associated payload object.
  #
  # pkg:gem/resque#lib/resque/job.rb:74
  def payload; end

  # Returns the actual class constant represented in this job's payload.
  #
  # pkg:gem/resque#lib/resque/job.rb:210
  def payload_class; end

  # Returns the payload class as a string without raising NameError
  #
  # pkg:gem/resque#lib/resque/job.rb:215
  def payload_class_name; end

  # Attempts to perform the work represented by this job instance.
  # Calls #perform on the class given in the payload with the
  # arguments given in the payload.
  #
  # pkg:gem/resque#lib/resque/job.rb:150
  def perform; end

  # The name of the queue from which this job was pulled (or is to be
  # placed)
  #
  # pkg:gem/resque#lib/resque/job.rb:71
  def queue; end

  # Creates an identical job, essentially placing this job back on
  # the queue.
  #
  # pkg:gem/resque#lib/resque/job.rb:250
  def recreate; end

  # pkg:gem/resque#lib/resque/job.rb:17
  def redis; end

  # pkg:gem/resque#lib/resque/job.rb:302
  def run_always_hooks(job_failure = T.unsafe(nil)); end

  # pkg:gem/resque#lib/resque/job.rb:287
  def run_failure_hooks(exception); end

  # The worker object which is currently processing this job.
  #
  # pkg:gem/resque#lib/resque/job.rb:67
  def worker; end

  # The worker object which is currently processing this job.
  #
  # pkg:gem/resque#lib/resque/job.rb:67
  def worker=(_arg0); end

  class << self
    # Creates a job by placing it on a queue. Expects a string queue
    # name, a string class name, and an optional array of arguments to
    # pass to the class' `perform` method.
    #
    # Raises an exception if no queue or class is given.
    #
    # pkg:gem/resque#lib/resque/job.rb:87
    def create(queue, klass, *args); end

    # pkg:gem/resque#lib/resque/job.rb:26
    def data_store; end

    # Given a string, returns a Ruby object.
    #
    # pkg:gem/resque#lib/resque/job.rb:48
    def decode(object); end

    # Removes a job from a queue. Expects a string queue name, a
    # string class name, and, optionally, args.
    #
    # Returns the number of jobs destroyed.
    #
    # If no args are provided, it will remove all jobs of the class
    # provided.
    #
    # That is, for these two jobs:
    #
    # { 'class' => 'UpdateGraph', 'args' => ['defunkt'] }
    # { 'class' => 'UpdateGraph', 'args' => ['mojombo'] }
    #
    # The following call will remove both:
    #
    #   Resque::Job.destroy(queue, 'UpdateGraph')
    #
    # Whereas specifying args will only remove the 2nd job:
    #
    #   Resque::Job.destroy(queue, 'UpdateGraph', 'mojombo')
    #
    # This method can be potentially very slow and memory intensive,
    # depending on the size of your queue, as it loads all jobs into
    # a Ruby array before processing.
    #
    # pkg:gem/resque#lib/resque/job.rb:123
    def destroy(queue, klass, *args); end

    # Given a Ruby object, returns a string suitable for storage in a
    # queue.
    #
    # pkg:gem/resque#lib/resque/job.rb:43
    def encode(object); end

    # pkg:gem/resque#lib/resque/job.rb:22
    def redis; end

    # Given a string queue name, returns an instance of Resque::Job
    # if any jobs are available. If not, returns nil.
    #
    # pkg:gem/resque#lib/resque/job.rb:142
    def reserve(queue); end
  end
end

# Raise Resque::Job::DontPerform from a before_perform hook to
# abort the job.
#
# pkg:gem/resque#lib/resque/job.rb:64
class Resque::Job::DontPerform < ::StandardError; end

# Include this module in classes you wish to have logging facilities
#
# pkg:gem/resque#lib/resque/logging.rb:3
module Resque::Logging
  private

  # Log level aliases
  #
  # pkg:gem/resque#lib/resque/logging.rb:12
  def debug(message); end

  # pkg:gem/resque#lib/resque/logging.rb:15
  def error(message); end

  # pkg:gem/resque#lib/resque/logging.rb:16
  def fatal(message); end

  # pkg:gem/resque#lib/resque/logging.rb:13
  def info(message); end

  # pkg:gem/resque#lib/resque/logging.rb:14
  def warn(message); end

  class << self
    # Log level aliases
    #
    # pkg:gem/resque#lib/resque/logging.rb:12
    def debug(message); end

    # pkg:gem/resque#lib/resque/logging.rb:15
    def error(message); end

    # pkg:gem/resque#lib/resque/logging.rb:16
    def fatal(message); end

    # pkg:gem/resque#lib/resque/logging.rb:13
    def info(message); end

    # Thunk to the logger's own log method (if configured)
    #
    # pkg:gem/resque#lib/resque/logging.rb:7
    def log(severity, message); end

    # pkg:gem/resque#lib/resque/logging.rb:14
    def warn(message); end
  end
end

# multi_json renamed it's top-level constant from MultiJson to MultiJSON,
# keeping MultiJson as a deprecated alias until v2.0. Reference whichever name the
# installed version exposes so we stay compatible with future versions of multi_json
#
# pkg:gem/resque#lib/resque/helpers.rb:7
Resque::MultiJson = MultiJSON

# Raised when trying to create a job without a class
#
# pkg:gem/resque#lib/resque/errors.rb:6
class Resque::NoClassError < ::RuntimeError; end

# Raised whenever we need a queue but none is provided.
#
# pkg:gem/resque#lib/resque/errors.rb:3
class Resque::NoQueueError < ::RuntimeError; end

# pkg:gem/resque#lib/resque/plugin.rb:2
module Resque::Plugin
  extend ::Resque::Plugin

  # Given an object, returns a list `after_dequeue` hook names.
  #
  # pkg:gem/resque#lib/resque/plugin.rb:74
  def after_dequeue_hooks(job); end

  # Given an object, returns a list `after_enqueue` hook names.
