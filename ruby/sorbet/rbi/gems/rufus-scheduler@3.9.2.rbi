  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:275
  def trigger_now(time); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:362
  def trigger_queue(time); end
