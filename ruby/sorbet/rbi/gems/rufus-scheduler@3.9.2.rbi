  def previous_time; end

  # previous "next trigger time"
  #
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:31
  def previous_time=(_arg0); end

  # Default, core, implementation has no effect. Repeat jobs do override it.
  #
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:44
  def resume_discard_past=(v); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:157
  def running?; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:162
