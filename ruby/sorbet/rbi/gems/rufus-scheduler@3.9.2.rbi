# pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:4
Rufus::Scheduler::Job::EoTime = EtOrbi::EoTime

# Used by Job#kill
#
# pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:9
class Rufus::Scheduler::Job::KillSignal < ::StandardError; end

# The array rufus-scheduler uses to keep jobs in order (next to trigger
# first).
#
# pkg:gem/rufus-scheduler#lib/rufus/scheduler/job_array.rb:6
class Rufus::Scheduler::JobArray
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/job_array.rb:8
  def initialize; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/job_array.rb:52
  def [](job_id); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/job_array.rb:41
  def delete_unscheduled; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/job_array.rb:26
  def each(now, &block); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/job_array.rb:14
  def push(job); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/job_array.rb:21
  def size; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/job_array.rb:47
  def to_a; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/job_array.rb:57
  def unschedule_all; end
end

# MIN_WORK_THREADS = 3
#
# pkg:gem/rufus-scheduler#lib/rufus/scheduler.rb:40
Rufus::Scheduler::MAX_WORK_THREADS = T.let(T.unsafe(nil), Integer)

# For when the scheduler is not running
# (it got shut down or didn't start because of a lock)
#
# pkg:gem/rufus-scheduler#lib/rufus/scheduler.rb:37
class Rufus::Scheduler::NotRunningError < ::Rufus::Scheduler::Error; end

# A lock that can always be acquired
#
# pkg:gem/rufus-scheduler#lib/rufus/scheduler/locks.rb:8
class Rufus::Scheduler::NullLock
  # Locking is always successful.
  #
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/locks.rb:12
  def lock; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/locks.rb:14
  def locked?; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/locks.rb:15
  def unlock; end
end

# pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_one_time.rb:2
class Rufus::Scheduler::OneTimeJob < ::Rufus::Scheduler::Job
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_one_time.rb:6
  def occurrences(time0, time1); end

  # Used when discard_past? is set to true or :fail at scheduler or job level...
  #
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_one_time.rb:13
  def past?; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_one_time.rb:4
  def time; end

  protected

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_one_time.rb:21
  def determine_id; end

  # There is no "next time" for one time jobs, hence the false.
  #
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_one_time.rb:33
  def set_next_time(trigger_time, is_post = T.unsafe(nil), now = T.unsafe(nil)); end
end

# pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:2
class Rufus::Scheduler::RepeatJob < ::Rufus::Scheduler::Job
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:10
  def initialize(scheduler, duration, opts, block); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:107
  def determine_id; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:6
  def first_at; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:36
  def first_at=(first); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:7
  def last_at; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:58
  def last_at=(last); end

  # Starting from now, returns the {count} next occurences
  # (EtOrbi::EoTime instances) for this job.
  #
  # Warning, for IntervalJob, the @mean_work_time is used since
  # "interval" works from the end of a job to its next trigger
  # (not from one trigger to the next, as for "cron" and "every").
  #
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:144
  def next_times(count); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:116
  def occurrences(time0, time1); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:91
  def pause; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:102
  def paused?; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:4
  def paused_at; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:96
  def resume(opts = T.unsafe(nil)); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:8
  def times; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:8
  def times=(_arg0); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:76
  def trigger(time); end
end

# pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_repeat.rb:34
Rufus::Scheduler::RepeatJob::FIRSTS = T.let(T.unsafe(nil), Array)

