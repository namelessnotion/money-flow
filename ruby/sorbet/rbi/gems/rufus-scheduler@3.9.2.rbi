  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:23
  def name; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:23
  def name=(_arg0); end

  # next trigger time
  #
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:27
  def next_time; end

  # next trigger time
  #
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:27
  def next_time=(_arg0); end

  # def hash
  #  self.object_id
  # end
  # def eql?(o)
  #  o.class == self.class && o.hash == self.hash
  # end
  #
  # might be necessary at some point
  #
  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:196
  def next_times(count); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:12
  def opts; end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:13
  def original; end

  # Returns true if the job is scheduled in the past.
