  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:184
  def values; end

  protected

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:212
  def callback(meth, time); end

  # pkg:gem/rufus-scheduler#lib/rufus/scheduler/jobs_core.rb:222
  def compute_timeout; end

  # Scheduler level < Job level < this resume()'s level
