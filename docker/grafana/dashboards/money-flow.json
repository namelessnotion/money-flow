        "justifyMode": "center",
        "orientation": "auto"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Append conflict share",
      "description": "Share of appends that lost an optimistic-concurrency race. Expected under contention; a climb means hot streams.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
