      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(money_flow_eventstore_operation_duration_seconds_count{job=~\"$job\",money_flow_operation=~\"append|append_atomic\",money_flow_outcome=\"conflict\"}[$__rate_interval])) or vector(0)) / sum(rate(money_flow_eventstore_operation_duration_seconds_count{job=~\"$job\",money_flow_operation=~\"append|append_atomic\"}[$__rate_interval]))",
          "legendFormat": "Append conflict share",
          "refId": "A"
